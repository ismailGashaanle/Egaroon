# Dev: /api goes through the Vite proxy to http://localhost:5000 (no CORS).
# Production: set the full API origin, e.g. https://api.example.com/api
VITE_API_URL=/api

# Dev: leave empty to use the Vite page origin (proxied /socket.io).
# Production: set the Socket.IO server origin, e.g. https://api.example.com
VITE_SOCKET_URL=

# Cloudinary — public cloud name only (never put API secret in the client)
VITE_CLOUDINARY_CLOUD_NAME=y345vwr0

# OTP UI fallback if GET /auth/features is unreachable (server OTP_ENABLED is source of truth)
# Set true only when server also has OTP_ENABLED=true
VITE_OTP_ENABLED=false

# Vercel (no WebSocket server): turn off Socket.IO so the app doesn't retry /socket.io forever
# VITE_DISABLE_SOCKET=true
