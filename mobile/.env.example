# # E-Garoon API base (must include /api)
# # Android emulator → host machine:
# #   EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# # iOS simulator:
# #   EXPO_PUBLIC_API_URL=http://localhost:5000/api
# # Physical device (same Wi‑Fi as your PC):
# #   EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
# # EXPO_PUBLIC_API_URL=http://localhost:5000/api

# # Optional Socket.IO origin (defaults to API host without /api)
# # EXPO_PUBLIC_SOCKET_URL=http://192.168.x.x:5000

# # OTP UI fallback if GET /auth/features is unreachable (server OTP_ENABLED is source of truth)
# # Set true only when server also has OTP_ENABLED=true
# EXPO_PUBLIC_OTP_ENABLED=false

# # Web origin for Match Code share links (code + teamAPhone only — no secrets)
# # EXPO_PUBLIC_WEB_URL=https://egaroon.com




