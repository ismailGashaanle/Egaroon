# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Public API origin Google redirects to after sign-in (no trailing slash).
# Authorized redirect URI in Google Cloud Console:
#   {API_PUBLIC_URL}/api/auth/oauth/google/callback
API_PUBLIC_URL=http://localhost:5000

# Google OAuth (optional). When both are set, GET /auth/features returns oauthEnabled: true
# and Login/Register show Continue with Google. Leave blank to hide the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Override callback only if it is not {API_PUBLIC_URL}/api/auth/oauth/google/callback
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback
# Extra browser origins (comma-separated). In development, Expo web
# http://localhost:8081|8082 and 127.0.0.1 variants are allowed automatically.
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082

# MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kulansiiye?retryWrites=true&w=majority&appName=Cluster0

# Redis (booking-slot holds / distributed locks)
# Optional in development: if Redis is not running, the API uses an in-memory
# Map fallback so auth/register/Mongo still work. Multi-instance / production
# needs a real Redis. Set REDIS_ENABLED=false to skip Redis entirely.
REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=false

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Business rules
BOOKING_HOLD_MINUTES=10
BOOKING_HOLD_GRACE_MINUTES=2
TEAM_B_PAYMENT_MINUTES=10
AUTO_REFUND_TEAM_A_ON_TEAM_B_TIMEOUT=true
RELEASE_SLOT_ON_PARTIAL_PAYMENT_TIMEOUT=true
PLATFORM_COMMISSION_PERCENT=4
OWNER_PAYOUT_DELAY_MINUTES=60
NO_SHOW_GRACE_MINUTES=15

# Payments: mock | waafipay | dahabpay | sifalopay | auto
#   mock  — full USSD simulation + mock-confirm / mock-fail (dev)
#   auto  — hormuud→waafipay, golis→dahabpay, telesom/somtel→mock until partner APIs
#   waafipay | dahabpay — force one adapter for all operators
PAYMENT_PROVIDER=mock

# Mock balance fail: phones ending …9999, or MOCK_FORCE_INSUFFICIENT=true
# MOCK_FORCE_INSUFFICIENT=false
# MOCK_WEBHOOK_SECRET=

# SifaloPay e-Wallet (Waafi/ZAAD/EVC, eDahab, Premier) — https://developer.sifalopay.com/docs/e-wallet-api
# Webhook URL (sent automatically when API_PUBLIC_URL is https): {API_PUBLIC_URL}/api/webhooks/payments/sifalopay
# SIFALO_API_USER=
# SIFALO_API_KEY=
# Sandbox keys (from pay.sifalo.net)  -> SIFALO_API_BASE_URL=https://spay-api.sifalo.net/gateway   (test wallets only, no real money)
# Live keys    (from pay.sifalo.com)  -> leave unset (defaults to https://api.sifalopay.com/gateway)
# Staging and live keys are NOT interchangeable. Sandbox test wallets: https://developer.sifalopay.com/docs/sandbox
# SIFALO_API_BASE_URL=

# WaafiPay (Hormuud / Zaad) — https://docs.waafipay.com/api-introduction
# Webhook URL to register: {SERVER_URL}/api/webhooks/payments/waafipay
# WAAFI_API_BASE_URL=https://api.waafipay.net
# WAAFI_MERCHANT_UID=
# WAAFI_API_USER_ID=
# WAAFI_API_KEY=
# WAAFI_WEBHOOK_SECRET=

# eDahab / DahabPay (Golis) — http://docs.edahab.net/
# Webhook URL to register: {SERVER_URL}/api/webhooks/payments/dahabpay
# EDAHAB_API_BASE_URL=https://edahab.net/api
# EDAHAB_API_KEY=
# EDAHAB_AGENT_CODE=
# EDAHAB_WEBHOOK_SECRET=
# EDAHAB_RETURN_URL=http://localhost:5173

# Cookies
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# OTP delivery (register + forgot password)
# ---------------------------------------------------------------------------
# Master switch — set true to require OTP again on register / forgot-password.
# When false: register skips emailOtp/phoneOtp; reset uses email|phone + new password only.
# Production should re-enable OTP (OTP_ENABLED=true) before public launch.
OTP_ENABLED=false
#
# OTP_PROVIDER=mock|twilio   (default mock — safe for local; never exposes real SMS)
#
# Approach: Twilio Verify (Option A) — Twilio generates + checks codes.
#   Safer than Programmable Messaging: fraud tools, rate limits, no OTP in our DB.
#   Email channel always uses local hashed OTP (console/mock until SMTP).
#   Phone uses Verify when OTP_PROVIDER=twilio.
#
# Setup (Twilio Console — free trial OK for testing):
#   1. Create account → https://www.twilio.com/try-twilio
#   2. Copy Account SID + Auth Token (Dashboard). NEVER commit Auth Token.
#      NEVER put TWILIO_* in client/.env or Vite — server only.
#   3. Verify → Services → Create service → enable SMS (WhatsApp optional).
#   4. Copy Service SID (starts with VA…).
#   5. Phone Numbers → Geo permissions: enable Somalia (+252) for SMS if available.
#      WARNING: Somalia SMS often needs geo permissions and may be limited on trial.
#      If +252 delivery fails, keep mock for phone testing, or plan Africa's Talking /
#      Waafi SMS as a future adapter (see AfricasTalkingProvider stub).
#   6. Trial: verify your personal test numbers in Twilio Console before send works.
#
# Cost/fraud: Prefer Verify over raw SMS for OTP. Fail closed — if OTP_PROVIDER=twilio
# but credentials missing, API errors clearly (does not silently fall back to mock codes).
#
OTP_PROVIDER=mock
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_never_commit
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: sms (default) or whatsapp if enabled on the Verify Service
# OTP_TWILIO_CHANNEL=sms
# Future regional fallback (not implemented): AT_USERNAME= AT_API_KEY= AT_SENDER_ID=

# ---------------------------------------------------------------------------
# Storage: Cloudflare R2 (Recommended) | Cloudinary (Fallback)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=cloudflare

# Cloudflare R2 Object Storage (https://dash.cloudflare.com)
# Setup steps:
#   1. Sign in to https://dash.cloudflare.com → Click "R2 Object Storage"
#   2. Create a Bucket (e.g. "kulansiiye")
#   3. Under R2 Overview, click "Manage R2 API Tokens" → Create API Token with Object Read & Write
#   4. Copy Account ID, Access Key ID, and Secret Access Key
#   5. In your bucket settings, enable R2.dev public URL (e.g. https://pub-xxxx.r2.dev) or connect a custom domain
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=kulansiiye
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Cloudinary (Fallback if STORAGE_PROVIDER=cloudinary)
# Never put CLOUDINARY_API_SECRET or CLOUDINARY_URL in the Vite client.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vercel deployment
# Secret the cron endpoint (/api/cron) requires as 'Authorization: Bearer <CRON_SECRET>'. Use a long random value.
# CRON_SECRET=

# Cloudflare Turnstile (free CAPTCHA) — dash.cloudflare.com → Turnstile → add site (egaroon.com)
# Both keys switch it on for register, login, forgot password, OTP sending and withdrawals.
# The site key is public (the API hands it to the browser); the secret key stays on the server.
# Local testing keys (always pass): TURNSTILE_SITE_KEY=1x00000000000000000000AA  TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# DEMO ONLY — fixed sample code asked for after the password (for testing/demos, NOT real security).
# Leave unset for a normal login. Replace with real authenticator-app 2FA before real customers use the site.
# DEMO_2FA_CODE=123456            (several allowed, comma-separated: DEMO_2FA_CODE=123456,654321)
